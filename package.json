{
  "name": "challengelight-it",
  "version": "1.0.0",
  "private": true,
  "description": "Light-it QA challenge: reschedule testing report, SQL, Postman collection and Playwright UI flows",
  "type": "commonjs",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "test": "playwright test --project=ui",
    "test:headed": "playwright test --project=ui --headed",
    "test:list": "playwright test --project=ui --list --reporter=list",
    "test:extras": "playwright test --project=extras-api",
    "test:extras:writes": "playwright test --project=extras-api --grep @mutating",
    "test:debug": "playwright test --debug",
    "pw:ui": "playwright test --ui",
    "report": "playwright show-report",
    "codegen": "playwright codegen https://light-it-qa-challenge.vercel.app/login",
    "typecheck": "tsc",
    "lint": "oxlint",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.5.1",
    "@types/pg": "^8.23.1",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "eslint-plugin-playwright": "^2.11.0",
    "oxlint": "^1.82.0",
    "oxlint-tsgolint": "^7.0.2001",
    "pg": "^8.23.0",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2"
  }
}
