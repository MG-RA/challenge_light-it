# Copy to .env and fill in. Single-quote values: Node's .env parser treats an unquoted '#' as a comment.
# Keys are prefixed: on Windows, `username` collides with the built-in USERNAME env var.

# --- Web app ---
BASE_URL='https://light-it-qa-challenge.vercel.app'
APP_USER_EMAIL=''
APP_USER_PASSWORD=''
# Supplied with the challenge; not read by the suite.
APP_USER_ALIAS=''

# --- API ---
API_BASE_URL='https://qa-challenge-backend.vercel.app'
# Supplied with the challenge; not read by the suite.
SWAGGER_URL='https://qa-challenge-backend.vercel.app/swagger-login'

# --- Test run ---
# IANA zone shared by test date math and the browser. Optional; defaults to UTC, which CI uses.
TEST_TIMEZONE='UTC'

# --- Database (read-only) ---
# Supplied with the challenge; not read by the suite (the driver is always Postgres).
DB_TYPE='postgres'
DB_HOST=''
DB_PORT='6543'
DB_NAME='postgres'
DB_USER=''
DB_PASSWORD=''
