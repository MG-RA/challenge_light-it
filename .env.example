# Copy to .env and fill in. Single-quote values: dotenv treats an unquoted '#' as a comment.
# Keys are prefixed: on Windows, `username` collides with the built-in USERNAME env var.

# --- Web app ---
BASE_URL='https://light-it-qa-challenge.vercel.app'
APP_USER_EMAIL=''
APP_USER_PASSWORD=''
APP_USER_ALIAS=''

# --- API ---
API_BASE_URL='https://qa-challenge-backend.vercel.app'
SWAGGER_URL='https://qa-challenge-backend.vercel.app/swagger-login'

# --- Database (read-only) ---
DB_TYPE='postgres'
DB_HOST=''
DB_PORT='6543'
DB_NAME='postgres'
DB_USER=''
DB_PASSWORD=''
