{
  "compilerOptions": {
    "target": "ES2025",
    "module": "preserve",
    "moduleResolution": "bundler",
    "lib": ["ES2025", "DOM"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["node"]
  },
  "include": ["src", "tests", "playwright.config.ts"]
}
